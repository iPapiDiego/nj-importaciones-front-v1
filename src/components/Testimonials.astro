---
const REVIEWS = [
  {
    name: "Valeria Morales",
    city: "Lima, San Isidro",
    rating: 5,
    product: "Labial Líquido Velvet Matte",
    comment: "¡Me encantó la duración! Lo usé para un evento de 8 horas, comí y bebí y el labial seguía intacto sin manchar. Además pagué con Yape en un minuto y el envío llegó al día siguiente super bien empaquetado.",
    date: "Hace 3 días"
  },
  {
    name: "Camila Rivas",
    city: "Arequipa",
    rating: 5,
    product: "Set Esmaltes Gel Polish UV",
    comment: "Los tonos pastel son bellísimos y el secado es realmente rápido. No se descascaran para nada y brillan como de salón. Es mi segunda compra en NJ Importaciones y 100% recomendado.",
    date: "Hace 1 semana"
  },
  {
    name: "Fiorella Sandoval",
    city: "Trujillo",
    rating: 5,
    product: "Serum Vitamina C + Ácido Hialurónico",
    comment: "Tenía manchitas por el sol y este serum me ha cambiado la textura de la piel en solo dos semanas. Textura ligera que no deja grasoso el rostro. La atención por WhatsApp fue súper amable.",
    date: "Hace 2 semanas"
  }
];
---

<section class="py-16 sm:py-20 bg-pink-50/40 border-t border-pink-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto mb-12 reveal-on-scroll">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-pink-100 border border-brand-pink/30 text-brand-pink-hover text-xs font-bold uppercase tracking-wider mb-3">
        <span>Testimonios Reales</span>
      </div>
      <h2 class="font-serif text-3xl sm:text-4xl font-extrabold text-gray-900 tracking-tight">
        Lo Que Dicen Nuestras Clientas
      </h2>
      <p class="mt-3 text-sm sm:text-base text-gray-600">
        Miles de mujeres en todo el Perú confían en NJ Importaciones para resaltar su belleza.
      </p>
    </div>

    <!-- Reviews Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {REVIEWS.map((review, idx) => (
        <div class:list={[
          "bg-white rounded-3xl p-8 border border-pink-100 shadow-sm hover:shadow-lg transition-all flex flex-col justify-between reveal-on-scroll",
          idx === 1 ? "delay-100" : idx === 2 ? "delay-200" : ""
        ]}>
          <div>
            <!-- Stars & Verified Badge -->
            <div class="flex items-center justify-between mb-4">
              <div class="flex text-amber-400 text-sm tracking-wide">
                {"★".repeat(review.rating)}
              </div>
              <span class="inline-flex items-center gap-1 text-[11px] text-emerald-700 bg-emerald-50 px-2.5 py-0.5 rounded-full font-semibold">
                <svg class="w-3 h-3 text-emerald-500" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                </svg>
                Compra Verificada
              </span>
            </div>

            <!-- Product Tag -->
            <p class="text-xs font-semibold text-brand-pink mb-2">
              Producto: {review.product}
            </p>

            <!-- Review Text -->
            <p class="text-xs sm:text-sm text-gray-700 leading-relaxed italic">
              "{review.comment}"
            </p>
          </div>

          <!-- Author Info -->
          <div class="pt-6 border-t border-pink-50 mt-6 flex items-center justify-between">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-full bg-gradient-to-tr from-brand-pink to-pink-300 text-white font-bold flex items-center justify-center text-sm shadow-sm">
                {review.name.charAt(0)}
              </div>
              <div>
                <p class="font-serif font-bold text-sm text-gray-900">{review.name}</p>
                <p class="text-[11px] text-gray-500">{review.city}</p>
              </div>
            </div>
            <span class="text-[10px] text-gray-400">{review.date}</span>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
