---
import IconInstagram from '../assets/icons/IconInstagram.astro';
import IconTikTok from '../assets/icons/IconTikTok.astro';
import IconFacebook from '../assets/icons/IconFacebook.astro';
import IconWhatsApp from '../assets/icons/IconWhatsApp.astro';
import { SITE_CONFIG } from '../config/site';
import { buildWhatsAppLink } from '../utils/format';

const FEED_ITEMS = [
  {
    image: "/products/lipstick-matte.jpg",
    type: "Reel",
    views: "34.2K",
    caption: "¡Swatch de los 4 tonos Velvet Matte! ¿Cuál es tu favorito? 💄✨",
    platform: "tiktok"
  },
  {
    image: "/products/nail-polish-pink.jpg",
    type: "Post",
    views: "1.8K likes",
    caption: "Uñas perfectas en 60 segundos con nuestro esmalte Diamond Shine 💅",
    platform: "instagram"
  },
  {
    image: "/products/serum-face.jpg",
    type: "Reel",
    views: "48.9K",
    caption: "Rutina antimanchas con Vitamina C & Ácido Hialurónico ✨ Piel luminosa",
    platform: "tiktok"
  },
  {
    image: "/products/blush-liquid.jpg",
    type: "Post",
    views: "2.4K likes",
    caption: "El rubor más viral del momento ya está disponible en Perú 🌸",
    platform: "instagram"
  }
];
---

<section id="redes" class="py-16 sm:py-24 bg-white relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto mb-14 reveal-on-scroll">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-pink-100 border border-brand-pink/30 text-brand-pink-hover text-xs font-bold uppercase tracking-wider mb-3">
        <span>#NJBelleza</span>
      </div>
      <h2 class="font-serif text-3xl sm:text-4xl font-extrabold text-gray-900 tracking-tight">
        Conéctate con Nuestra Comunidad
      </h2>
      <p class="mt-3 text-sm sm:text-base text-gray-600">
        Descubre tutoriales, tendencias, opiniones de clientas reales y contenido exclusivo en nuestras redes oficiales.
      </p>
    </div>

    <!-- 4 Big Social Cards Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-16">
      
      <!-- Instagram Card -->
      <a 
        href={SITE_CONFIG.social.instagram.url} 
        target="_blank" 
        rel="noopener noreferrer"
        class="reveal-on-scroll group relative bg-gradient-to-br from-pink-50 via-white to-pink-50/50 rounded-3xl p-6 border border-pink-100 shadow-sm hover:shadow-xl hover:border-pink-300 transition-all duration-300 flex flex-col justify-between"
      >
        <div>
          <div class="w-14 h-14 rounded-2xl bg-gradient-to-tr from-[#f09433] via-[#e6683c] to-[#bc1888] text-white flex items-center justify-center mb-5 shadow-lg shadow-pink-500/20 group-hover:scale-110 transition-transform">
            <IconInstagram size={28} />
          </div>
          <span class="text-[11px] font-bold text-pink-500 uppercase tracking-wider">Instagram</span>
          <h3 class="font-serif font-bold text-xl text-gray-900 mt-1 mb-2">{SITE_CONFIG.social.instagram.handle}</h3>
          <p class="text-xs text-gray-600 leading-relaxed">
            Fotos de tonos reales, swatches diarios, historias con pedidos despachados y sorteos.
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-pink-100 flex items-center justify-between">
          <span class="text-xs font-semibold text-gray-800">{SITE_CONFIG.social.instagram.followers} Seguidoras</span>
          <span class="text-xs font-bold text-brand-pink group-hover:translate-x-1 transition-transform flex items-center gap-1">
            Seguir
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </span>
        </div>
      </a>

      <!-- TikTok Card -->
      <a 
        href={SITE_CONFIG.social.tiktok.url} 
        target="_blank" 
        rel="noopener noreferrer"
        class="reveal-on-scroll delay-100 group relative bg-gradient-to-br from-gray-900 via-brand-dark to-black text-white rounded-3xl p-6 border border-brand-pink/30 shadow-lg hover:shadow-2xl hover:border-brand-pink transition-all duration-300 flex flex-col justify-between"
      >
        <div>
          <div class="w-14 h-14 rounded-2xl bg-black border border-white/20 text-white flex items-center justify-center mb-5 shadow-lg shadow-black/50 group-hover:scale-110 transition-transform">
            <IconTikTok size={28} />
          </div>
          <span class="text-[11px] font-bold text-brand-pink uppercase tracking-wider">TikTok</span>
          <h3 class="font-serif font-bold text-xl text-white mt-1 mb-2">{SITE_CONFIG.social.tiktok.handle}</h3>
          <p class="text-xs text-gray-300 leading-relaxed">
            Videos virales, rutinas de maquillaje paso a paso, tests de duración e ingresos semanales.
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-white/10 flex items-center justify-between">
          <span class="text-xs font-semibold text-pink-200">{SITE_CONFIG.social.tiktok.followers} Seguidoras</span>
          <span class="text-xs font-bold text-brand-pink group-hover:translate-x-1 transition-transform flex items-center gap-1">
            Ver Videos
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </span>
        </div>
      </a>

      <!-- Facebook Card -->
      <a 
        href={SITE_CONFIG.social.facebook.url} 
        target="_blank" 
        rel="noopener noreferrer"
        class="reveal-on-scroll delay-200 group relative bg-gradient-to-br from-blue-50/50 via-white to-pink-50/30 rounded-3xl p-6 border border-blue-100 shadow-sm hover:shadow-xl hover:border-blue-300 transition-all duration-300 flex flex-col justify-between"
      >
        <div>
          <div class="w-14 h-14 rounded-2xl bg-[#1877F2] text-white flex items-center justify-center mb-5 shadow-lg shadow-blue-500/20 group-hover:scale-110 transition-transform">
            <IconFacebook size={28} />
          </div>
          <span class="text-[11px] font-bold text-blue-600 uppercase tracking-wider">Facebook</span>
          <h3 class="font-serif font-bold text-xl text-gray-900 mt-1 mb-2">{SITE_CONFIG.social.facebook.handle}</h3>
          <p class="text-xs text-gray-600 leading-relaxed">
            Transmisiones en vivo, catálogos en PDF descargables y atención a compras por mayor.
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-blue-50 flex items-center justify-between">
          <span class="text-xs font-semibold text-gray-800">{SITE_CONFIG.social.facebook.followers} Likes</span>
          <span class="text-xs font-bold text-blue-600 group-hover:translate-x-1 transition-transform flex items-center gap-1">
            Me Gusta
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </span>
        </div>
      </a>

      <!-- WhatsApp Direct Card -->
      <a 
        href={buildWhatsAppLink("Hola NJ Importaciones, quisiera asesoría sobre sus productos")} 
        target="_blank" 
        rel="noopener noreferrer"
        class="reveal-on-scroll delay-300 group relative bg-gradient-to-br from-emerald-50 via-white to-emerald-50/40 rounded-3xl p-6 border-2 border-emerald-500/40 shadow-sm hover:shadow-xl hover:border-emerald-500 transition-all duration-300 flex flex-col justify-between"
      >
        <div>
          <div class="w-14 h-14 rounded-2xl bg-[#25D366] text-white flex items-center justify-center mb-5 shadow-lg shadow-emerald-500/20 group-hover:scale-110 transition-transform">
            <IconWhatsApp size={28} />
          </div>
          <span class="text-[11px] font-bold text-emerald-600 uppercase tracking-wider">WhatsApp Directo</span>
          <h3 class="font-serif font-bold text-xl text-gray-900 mt-1 mb-2">{SITE_CONFIG.whatsapp.display}</h3>
          <p class="text-xs text-gray-600 leading-relaxed">
            Asesoría personalizada, confirmación inmediata de pagos con Yape y seguimiento de envíos.
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-emerald-100 flex items-center justify-between">
          <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-emerald-700">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            En Línea Ahora
          </span>
          <span class="text-xs font-bold text-emerald-600 group-hover:translate-x-1 transition-transform flex items-center gap-1">
            Chatear
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </span>
        </div>
      </a>

    </div>

    <!-- Feed Preview / UGC Content Section -->
    <div class="reveal-on-scroll bg-pink-50/50 rounded-3xl p-8 border border-pink-100">
      <div class="flex flex-col sm:flex-row items-center justify-between gap-4 mb-6">
        <div>
          <h4 class="font-serif text-xl font-bold text-gray-900">Lo Más Visto en Nuestras Redes</h4>
          <p class="text-xs text-gray-600">Mira cómo lucen nuestros cosméticos aplicados en piel real.</p>
        </div>
        <span class="text-xs font-semibold text-brand-pink bg-white px-3 py-1.5 rounded-full border border-pink-200">
          Etiquétanos con @njimportaciones
        </span>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        {FEED_ITEMS.map((item) => (
          <div class="group relative aspect-4/5 rounded-2xl overflow-hidden shadow-sm bg-gray-100">
            <img 
              src={item.image} 
              alt={item.caption}
              loading="lazy" 
              class="w-full h-full object-cover object-center group-hover:scale-110 transition-transform duration-500"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent opacity-80 group-hover:opacity-95 transition-opacity flex flex-col justify-between p-3.5 text-white">
              <div class="flex items-center justify-between">
                <span class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-md bg-white/20 backdrop-blur-xs">
                  {item.type}
                </span>
                <span class="text-[10px] font-semibold text-pink-200">
                  {item.views}
                </span>
              </div>
              <p class="text-[11px] text-gray-200 line-clamp-2 leading-tight">
                {item.caption}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>
