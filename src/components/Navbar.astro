---
import { Image } from 'astro:assets';
import logoImg from '../assets/logo.jpeg';
import IconInstagram from '../assets/icons/IconInstagram.astro';
import IconTikTok from '../assets/icons/IconTikTok.astro';
import IconWhatsApp from '../assets/icons/IconWhatsApp.astro';
import IconFacebook from '../assets/icons/IconFacebook.astro';
import { SITE_CONFIG } from '../config/site';
import { buildWhatsAppLink, formatPEN } from '../utils/format';
---

<!-- Announcement Bar -->
<div class="bg-gradient-to-r from-brand-dark via-[#1a1118] to-brand-dark border-b border-brand-pink/20 text-white py-1.5 sm:py-2 px-3 sm:px-4 text-center">
  <div class="max-w-7xl mx-auto flex items-center justify-between text-[11px] sm:text-xs">
    <div class="hidden md:flex items-center gap-4 text-pink-200">
      <span class="inline-flex items-center gap-1.5">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        Atención Inmediata por WhatsApp
      </span>
      <span>•</span>
      <span>Envíos a todo el Perú</span>
    </div>
    
    <div class="mx-auto md:mx-0 font-medium tracking-wide flex items-center justify-center gap-2">
      <span class="text-brand-pink font-semibold">✨ ENVIOS GRATIS</span>
      <span class="text-gray-200">desde {formatPEN(SITE_CONFIG.shipping.freeThreshold)}</span>
      <span class="bg-brand-pink/20 text-pink-300 px-2 py-0.5 rounded-full text-[10px] uppercase font-bold border border-brand-pink/40">
        Paga con Yape
      </span>
    </div>

    <div class="hidden lg:flex items-center gap-3">
      <a href={SITE_CONFIG.social.instagram.url} target="_blank" rel="noopener noreferrer" class="text-pink-300 hover:text-white transition-colors" aria-label="Instagram">
        <IconInstagram size={15} />
      </a>
      <a href={SITE_CONFIG.social.tiktok.url} target="_blank" rel="noopener noreferrer" class="text-pink-300 hover:text-white transition-colors" aria-label="TikTok">
        <IconTikTok size={15} />
      </a>
      <a href={SITE_CONFIG.social.facebook.url} target="_blank" rel="noopener noreferrer" class="text-pink-300 hover:text-white transition-colors" aria-label="Facebook">
        <IconFacebook size={15} />
      </a>
    </div>
  </div>
</div>

<!-- Main Sticky Header -->
<header class="sticky top-0 z-40 bg-brand-dark/95 backdrop-blur-md border-b border-brand-pink/20 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 sm:h-20">
      
      <!-- Brand Logo -->
      <a href="/" class="flex items-center gap-2.5 sm:gap-3 group">
        <div class="relative w-9 h-9 sm:w-11 sm:h-11 rounded-full overflow-hidden ring-2 ring-brand-pink/60 group-hover:ring-brand-pink transition-all shadow-md shadow-pink-900/30 shrink-0">
          <Image 
            src={logoImg} 
            alt={`${SITE_CONFIG.name} Logo`} 
            width={88} 
            height={88} 
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
          />
        </div>
        <div class="flex flex-col">
          <div class="flex items-center gap-1">
            <span class="font-serif text-xl sm:text-2xl font-bold tracking-wider text-white group-hover:text-pink-200 transition-colors">
              {SITE_CONFIG.shortName}
            </span>
            <span class="text-brand-pink text-xs">♥</span>
          </div>
          <span class="text-[9px] sm:text-[10px] tracking-[0.25em] text-pink-300 font-semibold uppercase">
            Importaciones
          </span>
        </div>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden md:flex items-center gap-7 lg:gap-8">
        <a href="#inicio" class="text-sm font-medium text-white hover:text-brand-pink transition-colors relative py-1 hover:-translate-y-0.5">
          Inicio
        </a>
        <a href="#ofertas" class="text-sm font-medium text-pink-300 hover:text-white transition-colors flex items-center gap-1.5 py-1 hover:-translate-y-0.5">
          <span class="w-1.5 h-1.5 rounded-full bg-brand-rose animate-ping"></span>
          Ofertas Flash
        </a>
        <a href="#categorias" class="text-sm font-medium text-gray-200 hover:text-brand-pink transition-colors py-1 hover:-translate-y-0.5">
          Categorías
        </a>
        <a href="#catalogo" class="text-sm font-medium text-gray-200 hover:text-brand-pink transition-colors py-1 hover:-translate-y-0.5">
          Catálogo
        </a>
        <a href="#pagos" class="text-sm font-medium text-gray-200 hover:text-brand-pink transition-colors py-1 hover:-translate-y-0.5">
          Pagos & Envíos
        </a>
        <a href="#redes" class="text-sm font-medium text-gray-200 hover:text-brand-pink transition-colors py-1 hover:-translate-y-0.5">
          Comunidad
        </a>
      </nav>

      <!-- Action Buttons -->
      <div class="flex items-center gap-2.5 sm:gap-3">
        <!-- WhatsApp direct button (desktop) -->
        <a 
          href={buildWhatsAppLink("Hola NJ Importaciones, deseo consultar sobre sus cosméticos")} 
          target="_blank" 
          rel="noopener noreferrer"
          class="hidden sm:inline-flex items-center gap-2 bg-emerald-600/20 hover:bg-emerald-600/30 text-emerald-400 border border-emerald-500/30 px-3.5 py-1.5 rounded-full text-xs font-semibold transition-all hover:scale-105 active:scale-95 cursor-pointer"
        >
          <IconWhatsApp size={16} />
          <span>Consultas</span>
        </a>

        <!-- Shopping Cart Trigger Button -->
        <button 
          id="open-cart-btn"
          type="button"
          class="relative flex items-center justify-center p-2 sm:p-2.5 rounded-full bg-brand-pink/15 hover:bg-brand-pink/25 border border-brand-pink/30 text-white transition-all hover:scale-105 active:scale-95 cursor-pointer"
          aria-label="Ver carrito de compras"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-pink-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/>
          </svg>
          <span 
            id="cart-badge-count" 
            class="absolute -top-1 -right-1 bg-brand-pink text-white text-[11px] font-bold h-5 min-w-5 px-1.5 rounded-full flex items-center justify-center shadow-lg shadow-pink-900/50 scale-100 transition-transform"
          >
            0
          </span>
        </button>

        <!-- Mobile Menu Toggle Button (Strictly accessible & reliable) -->
        <button 
          id="mobile-menu-toggle"
          type="button"
          class="md:hidden flex items-center justify-center w-10 h-10 rounded-xl text-gray-200 hover:text-white bg-white/5 hover:bg-white/10 border border-white/10 transition-colors cursor-pointer"
          aria-label="Abrir menú de navegación"
          aria-expanded="false"
        >
          <svg id="menu-icon-open" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
          <svg id="menu-icon-close" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>

    </div>
  </div>
</header>

<!-- Fullscreen Mobile Navigation Drawer (Fixed directly to viewport, immune to containing block issues) -->
<div 
  id="mobile-menu" 
  class="fixed inset-0 z-50 bg-brand-dark/98 backdrop-blur-xl flex flex-col justify-between overflow-y-auto hidden md:hidden transition-all duration-300 p-5"
>
  <!-- Top Bar with Logo & Close Button -->
  <div class="flex items-center justify-between pb-4 border-b border-brand-pink/20">
    <div class="flex items-center gap-2.5">
      <div class="relative w-9 h-9 rounded-full overflow-hidden ring-2 ring-brand-pink/60 shrink-0">
        <Image 
          src={logoImg} 
          alt={`${SITE_CONFIG.name} Logo`} 
          width={88} 
          height={88} 
          class="w-full h-full object-cover"
        />
      </div>
      <div class="flex flex-col">
        <span class="font-serif text-lg font-bold tracking-wider text-white">
          {SITE_CONFIG.shortName} <span class="text-brand-pink text-xs">♥</span>
        </span>
        <span class="text-[9px] tracking-[0.25em] text-pink-300 font-semibold uppercase">
          Importaciones
        </span>
      </div>
    </div>

    <button 
      id="close-mobile-menu-btn"
      type="button"
      class="flex items-center justify-center w-10 h-10 rounded-xl text-gray-200 hover:text-white bg-white/10 hover:bg-white/20 border border-white/10 transition-colors cursor-pointer"
      aria-label="Cerrar menú"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>
  </div>

  <!-- Navigation Links -->
  <div class="py-4 space-y-1">
    <a href="#inicio" class="block py-3 text-base font-semibold text-white hover:text-brand-pink border-b border-white/10 mobile-nav-link transition-colors">
      Inicio
    </a>
    <a href="#ofertas" class="py-3 text-base font-semibold text-pink-300 hover:text-white border-b border-white/10 mobile-nav-link transition-colors flex items-center justify-between">
      <span class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-brand-rose animate-ping"></span>
        Ofertas Flash
      </span>
      <span class="bg-brand-rose text-white text-[11px] px-2.5 py-0.5 rounded-full font-bold">Hasta -35%</span>
    </a>
    <a href="#categorias" class="block py-3 text-base font-semibold text-gray-200 hover:text-brand-pink border-b border-white/10 mobile-nav-link transition-colors">
      Categorías de Cosméticos
    </a>
    <a href="#catalogo" class="block py-3 text-base font-semibold text-gray-200 hover:text-brand-pink border-b border-white/10 mobile-nav-link transition-colors">
      Catálogo Completo
    </a>
    <a href="#pagos" class="block py-3 text-base font-semibold text-gray-200 hover:text-brand-pink border-b border-white/10 mobile-nav-link transition-colors">
      Métodos de Pago (Yape y Tarjetas)
    </a>
    <a href="#redes" class="block py-3 text-base font-semibold text-gray-200 hover:text-brand-pink border-b border-white/10 mobile-nav-link transition-colors">
      Comunidad & Redes Sociales
    </a>
  </div>

  <!-- Mobile Drawer Footer Actions -->
  <div class="pt-4 border-t border-white/10 space-y-3">
    <a 
      href={buildWhatsAppLink()} 
      target="_blank" 
      rel="noopener noreferrer"
      class="w-full py-3 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-sm tracking-wide shadow-lg shadow-emerald-900/40 flex items-center justify-center gap-2 transition-all active:scale-98"
    >
      <IconWhatsApp size={20} />
      <span>Chatear por WhatsApp ({SITE_CONFIG.whatsapp.display})</span>
    </a>

    <div class="flex items-center justify-center gap-4 text-pink-300 pt-1">
      <a href={SITE_CONFIG.social.instagram.url} target="_blank" rel="noopener noreferrer" class="p-2.5 bg-white/5 rounded-xl hover:text-white border border-white/10" aria-label="Instagram">
        <IconInstagram size={20} />
      </a>
      <a href={SITE_CONFIG.social.tiktok.url} target="_blank" rel="noopener noreferrer" class="p-2.5 bg-white/5 rounded-xl hover:text-white border border-white/10" aria-label="TikTok">
        <IconTikTok size={20} />
      </a>
      <a href={SITE_CONFIG.social.facebook.url} target="_blank" rel="noopener noreferrer" class="p-2.5 bg-white/5 rounded-xl hover:text-white border border-white/10" aria-label="Facebook">
        <IconFacebook size={20} />
      </a>
    </div>
  </div>
</div>

<script>
  // Robust Mobile Menu Controller with Scroll Lock
  const menuToggle = document.getElementById('mobile-menu-toggle');
  const closeMenuBtn = document.getElementById('close-mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuIconOpen = document.getElementById('menu-icon-open');
  const menuIconClose = document.getElementById('menu-icon-close');
  const navLinks = document.querySelectorAll('.mobile-nav-link');

  let isMenuOpen = false;

  function setMenuState(open: boolean) {
    isMenuOpen = open;
    if (open) {
      mobileMenu?.classList.remove('hidden');
      menuIconOpen?.classList.add('hidden');
      menuIconClose?.classList.remove('hidden');
      menuToggle?.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden'; // Lock background scroll
    } else {
      mobileMenu?.classList.add('hidden');
      menuIconOpen?.classList.remove('hidden');
      menuIconClose?.classList.add('hidden');
      menuToggle?.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = ''; // Unlock background scroll
    }
  }

  menuToggle?.addEventListener('click', (e) => {
    e.stopPropagation();
    setMenuState(!isMenuOpen);
  });

  closeMenuBtn?.addEventListener('click', () => {
    setMenuState(false);
  });

  navLinks.forEach(link => {
    link.addEventListener('click', () => {
      setMenuState(false);
    });
  });

  // Close on Escape key
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isMenuOpen) {
      setMenuState(false);
    }
  });

  // Close if window resizes to desktop breakpoint
  window.addEventListener('resize', () => {
    if (window.innerWidth >= 768 && isMenuOpen) {
      setMenuState(false);
    }
  });
</script>
