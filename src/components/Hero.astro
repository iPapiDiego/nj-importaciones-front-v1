---
import { Image } from 'astro:assets';
import logoImg from '../assets/logo.jpeg';
import IconWhatsApp from '../assets/icons/IconWhatsApp.astro';
import { SITE_CONFIG } from '../config/site';
import { buildWhatsAppLink } from '../utils/format';
---

<section id="inicio" class="relative bg-brand-dark overflow-hidden text-white pt-6 pb-14 sm:pt-12 sm:pb-20">
  <!-- Subtle Glowing background effects -->
  <div class="absolute inset-0 pointer-events-none overflow-hidden">
    <div class="absolute -top-32 left-1/2 -translate-x-1/2 w-[550px] sm:w-[700px] h-[400px] bg-gradient-to-b from-brand-pink/25 via-pink-600/10 to-transparent blur-3xl rounded-full opacity-60"></div>
    <div class="absolute top-1/3 -left-20 w-60 h-60 bg-brand-pink/10 blur-3xl rounded-full"></div>
    <div class="absolute bottom-10 -right-20 w-72 h-72 bg-purple-900/15 blur-3xl rounded-full"></div>
    <div class="absolute inset-0 bg-[radial-gradient(#ec4899_1px,transparent_1px)] [background-size:24px_24px] opacity-10"></div>
  </div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 sm:gap-10 lg:gap-12 items-center">
      
      <!-- Visual Showcase Column: Appears FIRST on mobile (order-1), RIGHT on desktop (lg:order-2) -->
      <div class="lg:col-span-5 order-1 lg:order-2 relative flex items-center justify-center my-2 sm:my-0">
        
        <div class="relative w-64 h-64 sm:w-80 sm:h-80 lg:w-96 lg:h-96 rounded-3xl bg-gradient-to-tr from-pink-900/40 via-brand-dark-surface to-black p-1 ring-2 ring-brand-pink/50 shadow-2xl shadow-pink-900/50 flex items-center justify-center group">
          
          <!-- Animated gradient border glow -->
          <div class="absolute -inset-2 bg-gradient-to-r from-brand-pink via-purple-500 to-pink-400 rounded-3xl blur-xl opacity-40 group-hover:opacity-70 transition duration-700 animate-pulse-subtle"></div>

          <!-- Logo Container -->
          <div class="relative w-full h-full rounded-[22px] overflow-hidden bg-gradient-to-b from-[#181118] via-brand-dark to-[#120a14] flex flex-col items-center justify-center p-6 text-center">
            <Image 
              src={logoImg} 
              alt={`${SITE_CONFIG.name} Logo Oficial`} 
              width={340} 
              height={340} 
              class="w-full h-auto max-h-[195px] sm:max-h-[250px] object-contain drop-shadow-2xl transition-transform duration-500 group-hover:scale-105"
              loading="eager"
            />
          </div>

          <!-- Floating Badge 1: Discounts (Top Left) -->
          <div class="absolute -top-3 -left-2 sm:-top-4 sm:-left-4 bg-brand-dark-surface/95 backdrop-blur-md border border-brand-pink/40 rounded-2xl p-2 sm:p-2.5 shadow-xl flex items-center gap-2 sm:gap-2.5 animate-float z-10" style="animation-delay: 1.5s;">
            <div class="w-8 h-8 sm:w-9 sm:h-9 rounded-xl bg-gradient-to-tr from-brand-rose to-brand-pink flex items-center justify-center text-white text-xs sm:text-sm font-black shadow-inner shrink-0">
              %
            </div>
            <div class="text-left">
              <p class="text-[10px] sm:text-[11px] font-bold text-white leading-tight">Descuentos</p>
              <p class="text-[9px] sm:text-[10px] text-emerald-400 font-semibold">Hasta 35% OFF</p>
            </div>
          </div>

          <!-- Floating Badge 2: Yape (Top Right) -->
          <div class="absolute -top-3 -right-2 sm:-top-4 sm:-right-4 bg-brand-dark-surface/95 backdrop-blur-md border border-brand-pink/40 rounded-2xl p-2 sm:p-2.5 shadow-xl flex items-center gap-2 sm:gap-2.5 animate-float z-10">
            <div class="w-8 h-8 sm:w-9 sm:h-9 rounded-xl bg-[#9117A0] flex items-center justify-center text-white font-bold text-[10px] sm:text-xs shadow-inner shrink-0">
              YAPE
            </div>
            <div class="text-left">
              <p class="text-[10px] sm:text-[11px] font-bold text-white leading-tight">Paga con Yape</p>
              <p class="text-[9px] sm:text-[10px] text-pink-300">Sin comisiones</p>
            </div>
          </div>

          <!-- Floating Badge 3: Quick categories strip (Bottom Center) -->
          <div class="absolute -bottom-3.5 left-1/2 -translate-x-1/2 bg-brand-dark/95 backdrop-blur-md border border-brand-pink/40 px-3.5 py-1 rounded-full text-[10px] sm:text-xs text-pink-200 font-medium whitespace-nowrap shadow-lg flex items-center gap-2 z-10">
            <span>💄 Labiales</span>
            <span class="text-brand-pink text-[9px]">•</span>
            <span>💅 Esmaltes</span>
            <span class="text-brand-pink text-[9px]">•</span>
            <span>🌸 Skincare</span>
          </div>

        </div>

      </div>

      <!-- Copy & Actions Column: Appears SECOND on mobile (order-2), LEFT on desktop (lg:order-1) -->
      <div class="lg:col-span-7 order-2 lg:order-1 text-center lg:text-left space-y-4 sm:space-y-5">
        
        <!-- Eyebrow Tag -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-pink-950/70 border border-brand-pink/40 text-pink-300 text-[10px] sm:text-xs font-semibold tracking-wide shadow-sm shadow-pink-900/40">
          <span class="w-2 h-2 rounded-full bg-brand-pink animate-ping"></span>
          <span>COLECCIÓN 2026 • COSMÉTICOS ORIGINALES</span>
        </div>

        <!-- Main Headline -->
        <h1 class="font-serif text-2xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight leading-[1.2] text-white">
          Realza tu belleza con <br class="hidden sm:inline" />
          <span class="bg-gradient-to-r from-pink-200 via-brand-pink to-pink-300 bg-clip-text text-transparent">
            estilo, brillo y elegancia
          </span>
        </h1>

        <!-- Subtitle -->
        <p class="text-xs sm:text-sm lg:text-base text-gray-300 max-w-xl mx-auto lg:mx-0 font-normal leading-relaxed">
          Encuentra en <strong>{SITE_CONFIG.name}</strong> lo último en cosmética femenina: esmaltes en gel, labiales mate intransferibles y serums faciales con envíos rápidos a todo el Perú.
        </p>

        <!-- Payment & Delivery Highlights (Sleek horizontal row) -->
        <div class="flex flex-wrap items-center justify-center lg:justify-start gap-2 text-[11px] sm:text-xs font-medium text-pink-200/90 pt-0.5">
          <div class="flex items-center gap-1.5 bg-white/5 border border-white/10 px-2.5 py-1 rounded-lg">
            <svg class="w-3.5 h-3.5 text-brand-pink shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M5 13l4 4L19 7"/>
            </svg>
            <span>Paga con <strong>Yape & Tarjetas</strong></span>
          </div>
          <div class="flex items-center gap-1.5 bg-white/5 border border-white/10 px-2.5 py-1 rounded-lg">
            <svg class="w-3.5 h-3.5 text-brand-pink shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M5 13l4 4L19 7"/>
            </svg>
            <span>Envíos a <strong>todo el Perú</strong></span>
          </div>
          <div class="flex items-center gap-1.5 bg-white/5 border border-white/10 px-2.5 py-1 rounded-lg">
            <svg class="w-3.5 h-3.5 text-brand-pink shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M5 13l4 4L19 7"/>
            </svg>
            <span>Garantía <strong>100% Original</strong></span>
          </div>
        </div>

        <!-- Action CTAs (Mobile 2-column + WhatsApp full width) -->
        <div class="grid grid-cols-2 sm:flex sm:flex-row items-center justify-center lg:justify-start gap-2.5 sm:gap-3 pt-2">
          <a 
            href="#catalogo" 
            class="inline-flex items-center justify-center px-5 sm:px-7 py-2.5 sm:py-3 rounded-full bg-brand-pink hover:bg-brand-pink-hover text-white font-bold text-xs sm:text-sm tracking-wide shadow-lg shadow-pink-600/30 hover:shadow-pink-600/50 hover:-translate-y-0.5 active:translate-y-0 transition-all cursor-pointer"
          >
            <span>Ver Catálogo</span>
            <svg class="w-3.5 h-3.5 ml-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          </a>

          <a 
            href="#ofertas" 
            class="inline-flex items-center justify-center px-4 sm:px-6 py-2.5 sm:py-3 rounded-full bg-white/10 hover:bg-white/20 text-pink-200 hover:text-white border border-brand-pink/30 hover:border-brand-pink font-semibold text-xs sm:text-sm tracking-wide hover:-translate-y-0.5 active:translate-y-0 transition-all cursor-pointer"
          >
            <span class="mr-1 text-brand-pink">⚡</span>
            <span>Ofertas (-35%)</span>
          </a>

          <a 
            href={buildWhatsAppLink("Hola NJ Importaciones, deseo hacer un pedido")} 
            target="_blank" 
            rel="noopener noreferrer"
            class="col-span-2 sm:w-auto inline-flex items-center justify-center px-5 py-2.5 sm:py-3 rounded-full bg-emerald-600 hover:bg-emerald-500 text-white font-semibold text-xs sm:text-sm tracking-wide shadow-md shadow-emerald-900/30 hover:-translate-y-0.5 active:translate-y-0 transition-all"
            aria-label="Pedir por WhatsApp"
          >
            <IconWhatsApp size={16} class="mr-1.5" />
            <span>Pedir por WhatsApp</span>
          </a>
        </div>

        <!-- Social Proof Stats -->
        <div class="grid grid-cols-3 gap-2 sm:gap-4 pt-4 border-t border-white/10 max-w-md mx-auto lg:mx-0">
          <div>
            <p class="font-serif text-lg sm:text-2xl font-bold text-white">+5,000</p>
            <p class="text-[9px] sm:text-[11px] text-pink-200/70 uppercase tracking-wider mt-0.5">Clientas</p>
          </div>
          <div>
            <p class="font-serif text-lg sm:text-2xl font-bold text-white">100%</p>
            <p class="text-[9px] sm:text-[11px] text-pink-200/70 uppercase tracking-wider mt-0.5">Original</p>
          </div>
          <div>
            <p class="font-serif text-lg sm:text-2xl font-bold text-brand-pink">4.9 ★</p>
            <p class="text-[9px] sm:text-[11px] text-pink-200/70 uppercase tracking-wider mt-0.5">Opiniones</p>
          </div>
        </div>

      </div>

    </div>
  </div>
</section>
