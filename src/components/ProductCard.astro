---
import type { Product } from '../data/products';
import { formatPEN } from '../utils/format';

interface Props {
  product: Product;
  featured?: boolean;
  class?: string;
}

const { product, featured = false, class: className = '' } = Astro.props;
---

<div 
  class:list={[
    "product-card group relative bg-white rounded-2xl p-2.5 sm:p-4 border border-pink-100/90 shadow-sm hover:shadow-xl hover:border-brand-pink/50 transition-all duration-300 flex flex-col justify-between",
    className
  ]}
  data-category={product.category}
  data-product-id={product.id}
>
  <div>
    <!-- Image & Badges Container -->
    <div class="relative aspect-square w-full rounded-xl overflow-hidden bg-pink-50/50 mb-2.5 sm:mb-4">
      <img 
        src={product.image} 
        alt={product.name}
        loading="lazy" 
        class="w-full h-full object-cover object-center group-hover:scale-108 transition-transform duration-500 ease-out"
      />

      <!-- Discount Badge (Top Left) -->
      <span class="absolute top-2 left-2 bg-brand-rose text-white text-[10px] sm:text-[11px] font-bold px-1.5 sm:px-2 py-0.5 rounded-full shadow-md">
        {product.discount}
      </span>

      <!-- Status Badge (Top Right desktop) -->
      {product.badge && (
        <span class="hidden sm:inline-block absolute top-2 right-2 bg-brand-dark/90 backdrop-blur-sm text-pink-200 border border-brand-pink/30 text-[10px] font-semibold px-2 py-0.5 rounded-full shadow-sm">
          {product.badge}
        </span>
      )}

      <!-- Mobile Quick View Trigger (Accessible Top Right Icon on mobile) -->
      <button 
        type="button"
        data-quick-view-btn={product.id}
        class="sm:hidden absolute top-2 right-2 w-7 h-7 rounded-full bg-white/90 text-gray-700 shadow-md flex items-center justify-center hover:bg-brand-pink hover:text-white transition-colors cursor-pointer"
        aria-label={`Vista rápida de ${product.name}`}
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
        </svg>
      </button>

      <!-- Desktop Quick View Hover Action -->
      <button 
        type="button"
        data-quick-view-btn={product.id}
        class="hidden sm:flex absolute inset-x-4 bottom-3 bg-white/95 backdrop-blur-sm hover:bg-brand-pink hover:text-white text-gray-800 text-xs font-semibold py-2 rounded-xl shadow-lg opacity-0 translate-y-2 group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-300 items-center justify-center gap-1.5 cursor-pointer"
        aria-label={`Vista rápida de ${product.name}`}
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
        </svg>
        <span>Vista Rápida</span>
      </button>
    </div>

    <!-- Category & Stock Status -->
    <div class="flex items-center justify-between gap-1 mb-1 text-[10px] sm:text-xs">
      <span class="text-pink-500 font-medium uppercase tracking-wider text-[10px] sm:text-[11px] truncate">
        {product.categoryName}
      </span>
      
      {product.stock <= 5 ? (
        <span class="inline-flex items-center gap-1 text-[9px] sm:text-[11px] font-semibold text-rose-600 bg-rose-50 px-1.5 py-0.5 rounded border border-rose-200/60 shrink-0">
          <span class="w-1.5 h-1.5 rounded-full bg-rose-500 animate-pulse"></span>
          ¡Quedan {product.stock}!
        </span>
      ) : (
        <span class="inline-flex items-center gap-1 text-[9px] sm:text-[11px] font-medium text-emerald-700 bg-emerald-50 px-1.5 py-0.5 rounded shrink-0">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
          Stock ({product.stock})
        </span>
      )}
    </div>

    <!-- Product Title -->
    <h3 class="font-serif font-bold text-gray-900 text-xs sm:text-base line-clamp-2 group-hover:text-brand-pink transition-colors leading-snug">
      {product.name}
    </h3>

    <!-- Star Rating -->
    <div class="flex items-center gap-1 my-1.5">
      <div class="flex text-amber-400 text-[10px] sm:text-xs">
        {"★".repeat(Math.floor(product.rating))}
      </div>
      <span class="text-[10px] sm:text-xs font-semibold text-gray-700">{product.rating.toFixed(1)}</span>
      <span class="text-[9px] sm:text-[11px] text-gray-400">({product.reviewsCount})</span>
    </div>

    <!-- Shades Preview (if available) -->
    {product.shades && (
      <div class="hidden sm:flex items-center gap-1.5 my-2">
        <span class="text-[10px] text-gray-500 uppercase font-medium">Tonos:</span>
        <div class="flex items-center gap-1">
          {product.shades.map((shade) => (
            <span 
              class="w-3.5 h-3.5 rounded-full border border-gray-300 shadow-2xs inline-block" 
              style={`background-color: ${shade.hex};`}
              title={shade.name}
            ></span>
          ))}
        </div>
      </div>
    )}
  </div>

  <!-- Price & Add to Cart -->
  <div class="pt-2 sm:pt-3 border-t border-pink-50 mt-1.5 sm:mt-2">
    <div class="flex items-baseline gap-1.5 sm:gap-2 mb-2 sm:mb-3">
      <span class="text-sm sm:text-xl font-bold text-gray-900 font-sans">
        {formatPEN(product.price)}
      </span>
      <span class="text-[10px] sm:text-xs text-gray-400 line-through">
        {formatPEN(product.originalPrice)}
      </span>
    </div>

    <!-- Actions -->
    <div class="grid grid-cols-1 gap-1.5">
      <button 
        type="button"
        data-add-cart-btn
        data-id={product.id}
        data-name={product.name}
        data-price={product.price}
        data-image={product.image}
        data-category={product.categoryName}
        class="w-full flex items-center justify-center gap-1.5 py-2 sm:py-2.5 px-3 sm:px-4 rounded-xl bg-brand-pink hover:bg-brand-pink-hover text-white text-[11px] sm:text-xs font-bold tracking-wide shadow-md shadow-pink-200 hover:shadow-pink-300 hover:-translate-y-0.5 active:translate-y-0 transition-all cursor-pointer"
      >
        <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
        </svg>
        <span class="hidden sm:inline">Añadir al Carrito</span>
        <span class="sm:hidden">Añadir</span>
      </button>
    </div>
  </div>
</div>
