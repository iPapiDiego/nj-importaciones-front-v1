---
import { SITE_CONFIG } from '../config/site';
import { formatPEN } from '../utils/format';
---

<!-- Cart Drawer Overlay & Sidebar (Vanilla JS) -->
<div id="cart-drawer-container" class="fixed inset-0 z-50 pointer-events-none transition-all duration-300 hidden">
  
  <!-- Backdrop Overlay -->
  <div 
    id="cart-backdrop" 
    class="absolute inset-0 bg-black/60 opacity-0 transition-opacity duration-300 pointer-events-none cursor-pointer"
  ></div>

  <!-- Slide-out Drawer -->
  <div 
    id="cart-panel" 
    class="absolute right-0 top-0 bottom-0 w-full max-w-md bg-white shadow-2xl transform translate-x-full transition-transform duration-300 ease-out flex flex-col pointer-events-auto"
  >
    
    <!-- Drawer Header -->
    <div class="px-6 py-4 bg-brand-dark text-white flex items-center justify-between border-b border-brand-pink/20">
      <div class="flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-brand-pink" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/>
        </svg>
        <h3 class="font-serif font-bold text-lg">Tu Carrito de Belleza</h3>
        <span id="cart-items-counter-title" class="text-xs bg-brand-pink/30 text-pink-300 px-2 py-0.5 rounded-full font-bold">
          0 items
        </span>
      </div>

      <button 
        id="close-cart-btn" 
        type="button" 
        class="text-gray-300 hover:text-white p-1 rounded-lg hover:bg-white/10 transition-colors cursor-pointer"
        aria-label="Cerrar carrito"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>

    <!-- Free Delivery Progress Bar -->
    <div class="bg-pink-50 p-3.5 border-b border-pink-100 text-xs text-gray-700">
      <div id="free-shipping-text" class="flex items-center justify-between font-medium mb-1.5">
        <span>Envío GRATIS desde {formatPEN(SITE_CONFIG.shipping.freeThreshold)}</span>
        <span id="free-shipping-diff" class="text-brand-pink font-bold">Faltan {formatPEN(SITE_CONFIG.shipping.freeThreshold)}</span>
      </div>
      <div class="w-full h-2 bg-pink-200/60 rounded-full overflow-hidden">
        <div id="free-shipping-progress" class="h-full bg-gradient-to-r from-brand-pink to-pink-600 rounded-full transition-all duration-500" style="width: 0%;"></div>
      </div>
    </div>

    <!-- Cart Items List Container -->
    <div id="cart-items-list" class="flex-1 overflow-y-auto p-6 space-y-4">
      <!-- Items dynamically populated via JS -->
    </div>

    <!-- Empty Cart Fallback State -->
    <div id="empty-cart-state" class="hidden flex-1 flex flex-col items-center justify-center p-8 text-center">
      <div class="w-20 h-20 rounded-full bg-pink-50 text-brand-pink flex items-center justify-center text-3xl mb-4 border border-pink-100">
        🛍️
      </div>
      <h4 class="font-serif font-bold text-xl text-gray-900 mb-1">Tu carrito está vacío</h4>
      <p class="text-xs text-gray-500 max-w-xs mb-6">
        Explora nuestros labiales, esmaltes y cremas faciales para añadir tus productos favoritos.
      </p>
      <button 
        id="empty-cart-cta"
        type="button"
        class="px-6 py-2.5 rounded-full bg-brand-pink hover:bg-brand-pink-hover text-white text-xs font-bold shadow-md shadow-pink-200 transition-all cursor-pointer"
      >
        Explorar Productos
      </button>
    </div>

    <!-- Drawer Footer (Subtotal & Checkout) -->
    <div id="cart-footer" class="p-6 bg-gray-50 border-t border-gray-200/80 space-y-4">
      
      <!-- Subtotal Calculation -->
      <div class="space-y-1.5 text-xs text-gray-600">
        <div class="flex justify-between">
          <span>Subtotal estimado:</span>
          <span id="cart-subtotal" class="font-bold text-gray-900 text-sm">S/ 0.00</span>
        </div>
        <div class="flex justify-between text-emerald-600 font-medium">
          <span>Métodos de Pago:</span>
          <span>Yape, Tarjetas, BCP</span>
        </div>
      </div>

      <!-- WhatsApp Checkout CTA Button -->
      <button 
        id="whatsapp-checkout-btn"
        type="button"
        class="w-full py-3.5 px-4 rounded-xl bg-gradient-to-r from-[#25D366] to-emerald-600 hover:from-emerald-500 hover:to-emerald-700 text-white font-bold text-sm tracking-wide shadow-lg shadow-emerald-600/30 active:scale-98 transition-all flex items-center justify-center gap-2 cursor-pointer"
      >
        <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        <span>Pedir por WhatsApp (Yape / Tarjeta)</span>
      </button>

      <p class="text-[11px] text-center text-gray-500">
        Coordinación rápida y directa con una asesora de NJ Importaciones.
      </p>
    </div>

  </div>
</div>

<!-- Toast Notification -->
<div 
  id="cart-toast" 
  class="fixed bottom-6 left-1/2 -translate-x-1/2 z-50 bg-brand-dark/95 backdrop-blur-md text-white px-5 py-3 rounded-full border border-brand-pink/50 shadow-2xl opacity-0 translate-y-8 transition-all duration-300 pointer-events-none flex items-center gap-2 text-xs font-semibold"
>
  <span class="text-brand-pink">✓</span>
  <span id="toast-text">Producto añadido al carrito</span>
</div>

<script>
  import type { CartItem } from '../data/products';
  import { SITE_CONFIG } from '../config/site';
  import { formatPEN, buildOrderMessage, buildWhatsAppLink } from '../utils/format';

  let cart: CartItem[] = [];

  function loadCart() {
    try {
      const stored = localStorage.getItem('nj_cart');
      if (stored) {
        cart = JSON.parse(stored);
      }
    } catch {
      cart = [];
    }
    renderCart();
  }

  function saveCart() {
    try {
      localStorage.setItem('nj_cart', JSON.stringify(cart));
    } catch (e) {
      console.error(e);
    }
    renderCart();
  }

  function showToast(text: string) {
    const toast = document.getElementById('cart-toast');
    const toastText = document.getElementById('toast-text');
    if (!toast || !toastText) return;

    toastText.textContent = text;
    toast.classList.remove('opacity-0', 'translate-y-8', 'pointer-events-none');
    toast.classList.add('opacity-100', 'translate-y-0');

    setTimeout(() => {
      toast.classList.add('opacity-0', 'translate-y-8', 'pointer-events-none');
      toast.classList.remove('opacity-100', 'translate-y-0');
    }, 2400);
  }

  function openCartDrawer() {
    const container = document.getElementById('cart-drawer-container');
    const backdrop = document.getElementById('cart-backdrop');
    const panel = document.getElementById('cart-panel');

    container?.classList.remove('hidden', 'pointer-events-none');
    document.body.style.overflow = 'hidden';

    requestAnimationFrame(() => {
      backdrop?.classList.remove('opacity-0', 'pointer-events-none');
      backdrop?.classList.add('opacity-100');
      panel?.classList.remove('translate-x-full');
    });
  }

  function closeCartDrawer() {
    const container = document.getElementById('cart-drawer-container');
    const backdrop = document.getElementById('cart-backdrop');
    const panel = document.getElementById('cart-panel');

    document.body.style.overflow = '';
    backdrop?.classList.add('opacity-0', 'pointer-events-none');
    backdrop?.classList.remove('opacity-100');
    panel?.classList.add('translate-x-full');
    setTimeout(() => {
      container?.classList.add('hidden', 'pointer-events-none');
    }, 300);
  }

  function renderCart() {
    const badge = document.getElementById('cart-badge-count');
    const titleCounter = document.getElementById('cart-items-counter-title');
    const itemsList = document.getElementById('cart-items-list');
    const emptyState = document.getElementById('empty-cart-state');
    const cartFooter = document.getElementById('cart-footer');
    const subtotalEl = document.getElementById('cart-subtotal');
    const freeDiffEl = document.getElementById('free-shipping-diff');
    const freeProgressEl = document.getElementById('free-shipping-progress');

    const totalQty = cart.reduce((acc, item) => acc + item.quantity, 0);
    const subtotal = cart.reduce((acc, item) => acc + (item.price * item.quantity), 0);

    if (badge) badge.textContent = String(totalQty);
    if (titleCounter) titleCounter.textContent = `${totalQty} ${totalQty === 1 ? 'producto' : 'productos'}`;

    if (subtotalEl) subtotalEl.textContent = formatPEN(subtotal);

    // Free shipping threshold check via canonical config
    const threshold = SITE_CONFIG.shipping.freeThreshold;
    const remainingForFree = Math.max(0, threshold - subtotal);
    if (freeDiffEl && freeProgressEl) {
      if (remainingForFree === 0 && subtotal > 0) {
        freeDiffEl.textContent = '¡Envío GRATIS alcanzado! 🎉';
        freeDiffEl.className = 'text-emerald-600 font-bold';
        freeProgressEl.style.width = '100%';
        freeProgressEl.className = 'h-full bg-emerald-500 rounded-full transition-all duration-500';
      } else {
        freeDiffEl.textContent = `Faltan ${formatPEN(remainingForFree)}`;
        freeDiffEl.className = 'text-brand-pink font-bold';
        const pct = Math.min(100, Math.round((subtotal / threshold) * 100));
        freeProgressEl.style.width = `${pct}%`;
        freeProgressEl.className = 'h-full bg-gradient-to-r from-brand-pink to-pink-600 rounded-full transition-all duration-500';
      }
    }

    if (cart.length === 0) {
      itemsList?.classList.add('hidden');
      emptyState?.classList.remove('hidden');
      cartFooter?.classList.add('hidden');
      if (itemsList) itemsList.innerHTML = '';
      return;
    }

    itemsList?.classList.remove('hidden');
    emptyState?.classList.add('hidden');
    cartFooter?.classList.remove('hidden');

    if (!itemsList) return;
    itemsList.innerHTML = '';

    cart.forEach(item => {
      const itemEl = document.createElement('div');
      itemEl.className = 'flex items-center gap-3.5 p-3 rounded-2xl bg-pink-50/40 border border-pink-100/80';
      itemEl.innerHTML = `
        <img src="${item.image}" alt="${item.name}" class="w-16 h-16 rounded-xl object-cover border border-pink-100 shrink-0 bg-white" />
        <div class="flex-1 min-w-0">
          <h4 class="font-serif font-bold text-xs text-gray-900 line-clamp-1">${item.name}</h4>
          <p class="text-xs font-bold text-brand-pink mt-0.5">${formatPEN(item.price)}</p>
          <div class="flex items-center gap-2 mt-2">
            <button data-dec="${item.id}" class="w-6 h-6 rounded-md bg-white border border-pink-200 text-gray-700 hover:bg-pink-100 flex items-center justify-center text-xs font-bold cursor-pointer">-</button>
            <span class="text-xs font-bold px-1.5">${item.quantity}</span>
            <button data-inc="${item.id}" class="w-6 h-6 rounded-md bg-white border border-pink-200 text-gray-700 hover:bg-pink-100 flex items-center justify-center text-xs font-bold cursor-pointer">+</button>
          </div>
        </div>
        <div class="flex flex-col items-end justify-between self-stretch">
          <button data-remove="${item.id}" class="text-gray-400 hover:text-rose-600 p-1 transition-colors cursor-pointer" title="Eliminar">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
            </svg>
          </button>
          <span class="text-xs font-bold text-gray-900">${formatPEN(item.price * item.quantity)}</span>
        </div>
      `;
      itemsList.appendChild(itemEl);
    });

    // Wire item buttons
    itemsList.querySelectorAll('[data-inc]').forEach(btn => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-inc');
        const target = cart.find(i => i.id === id);
        if (target) {
          target.quantity++;
          saveCart();
        }
      });
    });

    itemsList.querySelectorAll('[data-dec]').forEach(btn => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-dec');
        const target = cart.find(i => i.id === id);
        if (target) {
          if (target.quantity > 1) {
            target.quantity--;
          } else {
            cart = cart.filter(i => i.id !== id);
          }
          saveCart();
        }
      });
    });

    itemsList.querySelectorAll('[data-remove]').forEach(btn => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-remove');
        cart = cart.filter(i => i.id !== id);
        saveCart();
        showToast('Producto eliminado del carrito');
      });
    });
  }

  // Canonical Event Bus listener for adding items (Code Judo)
  window.addEventListener('cart:add-item', ((event: CustomEvent<CartItem>) => {
    const item = event.detail;
    if (!item || !item.id) return;

    const existing = cart.find(i => i.id === item.id);
    if (existing) {
      existing.quantity += (item.quantity || 1);
    } else {
      cart.push({ ...item, quantity: item.quantity || 1 });
    }

    saveCart();
    showToast(`¡${item.name} añadido!`);
    openCartDrawer();
  }) as EventListener);

  // Global Add to Cart listener for standard card buttons
  document.addEventListener('click', (e) => {
    const target = (e.target as HTMLElement).closest('[data-add-cart-btn]') as HTMLButtonElement | null;
    if (target) {
      const id = target.getAttribute('data-id') || '';
      const name = target.getAttribute('data-name') || '';
      const price = parseFloat(target.getAttribute('data-price') || '0');
      const image = target.getAttribute('data-image') || '';
      const category = target.getAttribute('data-category') || '';

      window.dispatchEvent(new CustomEvent('cart:add-item', {
        detail: { id, name, price, image, category, quantity: 1 }
      }));
    }
  });

  // Drawer Open / Close listeners
  document.getElementById('open-cart-btn')?.addEventListener('click', openCartDrawer);
  document.getElementById('close-cart-btn')?.addEventListener('click', closeCartDrawer);
  document.getElementById('cart-backdrop')?.addEventListener('click', closeCartDrawer);
  document.getElementById('empty-cart-cta')?.addEventListener('click', () => {
    closeCartDrawer();
    document.getElementById('catalogo')?.scrollIntoView({ behavior: 'smooth' });
  });

  // WhatsApp Checkout Generator using canonical format utility
  document.getElementById('whatsapp-checkout-btn')?.addEventListener('click', () => {
    if (cart.length === 0) return;

    const subtotal = cart.reduce((acc, item) => acc + (item.price * item.quantity), 0);
    const message = buildOrderMessage(cart, subtotal);
    const url = buildWhatsAppLink(message);

    window.open(url, '_blank');
  });

  // Close on Escape key
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeCartDrawer();
  });

  // Initialize
  loadCart();
</script>
