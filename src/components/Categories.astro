---
const CATEGORY_CARDS = [
  {
    id: "labios",
    title: "Labiales & Gloss",
    tagline: "Mates velvet, tintas & voluminizadores",
    image: "/products/lipstick-matte.jpg",
    count: "15+ modelos",
    badge: "Tendencia",
    filterId: "labios"
  },
  {
    id: "unas",
    title: "Pintauñas & Esmaltes",
    tagline: "Efecto gel, secado express & glitters",
    image: "/products/nail-polish-pink.jpg",
    count: "24+ tonos",
    badge: "Top Ventas",
    filterId: "unas"
  },
  {
    id: "skincare",
    title: "Cremas & Skincare",
    tagline: "Hidratantes, serums & protector solar",
    image: "/products/face-cream.jpg",
    count: "18+ fórmulas",
    badge: "Cuidado Facial",
    filterId: "skincare"
  },
  {
    id: "rostro",
    title: "Maquillaje Rostro",
    tagline: "Bases filtro, rubores líquidos & polvos",
    image: "/products/blush-liquid.jpg",
    count: "20+ opciones",
    badge: "Alta Cobertura",
    filterId: "rostro"
  },
  {
    id: "ojos",
    title: "Sombras & Pestañas",
    tagline: "Paletas pigmentadas & máscaras waterproof",
    image: "/products/eyeshadow-palette.jpg",
    count: "12+ paletas",
    badge: "Mirada Impacto",
    filterId: "ojos"
  },
  {
    id: "accesorios",
    title: "Brochas & Accesorios",
    tagline: "Sets profesionales Rose Gold & esponjas",
    image: "/products/brushes-set.jpg",
    count: "Kits de lujo",
    badge: "Edición Especial",
    filterId: "todos"
  }
];
---

<section id="categorias" class="py-12 sm:py-20 bg-gradient-to-b from-brand-pink-light/60 to-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto mb-8 sm:mb-12 reveal-on-scroll">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-pink-100 border border-brand-pink/30 text-brand-pink-hover text-xs font-bold uppercase tracking-wider mb-2 sm:mb-3">
        <span>Variedad & Tendencias</span>
      </div>
      <h2 class="font-serif text-2xl sm:text-4xl font-bold text-gray-900 tracking-tight">
        Explora Nuestras Categorías
      </h2>
      <p class="mt-2 text-xs sm:text-base text-gray-600">
        Tenemos todo lo que necesitas para tu rutina de belleza diaria y profesional.
      </p>
    </div>

    <!-- Category Grid: 2 columns on mobile, 3 columns on lg -->
    <div class="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-6 lg:gap-8">
      {CATEGORY_CARDS.map((cat, idx) => (
        <a 
          href="#catalogo"
          data-category-trigger={cat.filterId}
          class:list={[
            "category-card reveal-on-scroll group relative h-44 sm:h-64 lg:h-72 rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1 border border-pink-100 hover:border-brand-pink/50 cursor-pointer block",
            idx % 3 === 1 ? "delay-100" : idx % 3 === 2 ? "delay-200" : ""
          ]}
        >
          <!-- Background Product Image -->
          <img 
            src={cat.image} 
            alt={cat.title} 
            loading="lazy"
            class="w-full h-full object-cover object-center group-hover:scale-108 transition-transform duration-500 ease-out"
          />

          <!-- Gradient Overlay -->
          <div class="absolute inset-0 bg-gradient-to-t from-brand-dark via-brand-dark/40 to-transparent group-hover:from-brand-dark/95 transition-colors"></div>

          <!-- Top Badge -->
          <div class="absolute top-2.5 left-2.5 sm:top-4 sm:left-4">
            <span class="inline-block px-2 sm:px-3 py-0.5 sm:py-1 bg-white/90 backdrop-blur-sm text-brand-pink-hover text-[10px] sm:text-xs font-bold rounded-full shadow-sm">
              {cat.badge}
            </span>
          </div>

          <!-- Bottom Content -->
          <div class="absolute bottom-0 inset-x-0 p-3 sm:p-6 text-white">
            <div class="flex items-center justify-between text-[10px] sm:text-xs text-pink-200 mb-0.5 sm:mb-1">
              <span class="font-medium">{cat.count}</span>
              <span class="hidden sm:inline-flex items-center gap-1 text-brand-pink font-semibold group-hover:translate-x-1 transition-transform">
                Ver Colección
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
              </span>
            </div>
            
            <h3 class="font-serif text-sm sm:text-xl lg:text-2xl font-bold text-white group-hover:text-pink-200 transition-colors leading-tight">
              {cat.title}
            </h3>
            
            <p class="text-[11px] text-gray-300 mt-1 line-clamp-1 hidden sm:block">
              {cat.tagline}
            </p>
          </div>
        </a>
      ))}
    </div>

  </div>
</section>

<script>
  // Link category clicks to catalog filter buttons
  const catCards = document.querySelectorAll('[data-category-trigger]');
  catCards.forEach(card => {
    card.addEventListener('click', () => {
      const targetCat = card.getAttribute('data-category-trigger');
      if (targetCat) {
        const filterBtn = document.querySelector(`[data-category-filter="${targetCat}"]`) as HTMLButtonElement | null;
        if (filterBtn) {
          filterBtn.click();
        }
      }
    });
  });
</script>
